/* ============================== AI / API LAYER ============================== */

const AI_MODEL = "claude-sonnet-4-6";

async function callClaude({ system, messages, max_tokens = 1200 }) {
  const response = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ model: AI_MODEL, max_tokens, system, messages }),
  });
  if (!response.ok) {
    throw new Error(`AI request failed (${response.status})`);
  }
  const data = await response.json();
  const text = (data.content || [])
    .map((block) => (block.type === "text" ? block.text : ""))
    .filter(Boolean)
    .join("\n");
  return text;
}

function extractJson(text) {
  let cleaned = text.trim();
  cleaned = cleaned.replace(/^```json\s*/i, "").replace(/^```\s*/i, "").replace(/```\s*$/i, "");
  const start = cleaned.indexOf("{");
  const end = cleaned.lastIndexOf("}");
  if (start === -1 || end === -1) throw new Error("No JSON object found in AI response");
  return JSON.parse(cleaned.slice(start, end + 1));
}

// Read a file into either { kind: "text", text } or { kind: "pdf", base64 }
async function readFileForAI(file) {
  const name = file.name.toLowerCase();
  if (name.endsWith(".pdf")) {
    const base64 = await new Promise((resolve, reject) => {
      const r = new FileReader();
      r.onload = () => resolve(r.result.split(",")[1]);
      r.onerror = () => reject(new Error("Could not read PDF file"));
      r.readAsDataURL(file);
    });
    return { kind: "pdf", base64 };
  }
  if (name.endsWith(".docx")) {
    const arrayBuffer = await file.arrayBuffer();
    const result = await mammoth.extractRawText({ arrayBuffer });
    return { kind: "text", text: result.value };
  }
  // .txt, .rtf, or anything else — read as plain text
  const text = await file.text();
  return { kind: "text", text };
}

const CANDIDATE_JSON_SCHEMA = `{
  "name": string,
  "role": string,               // candidate's current or most recent job title
  "company": string,            // candidate's current or most recent employer
  "location": string,
  "experience": number,         // total years of relevant professional experience, integer
  "email": string,              // best guess or "" if not present in resume
  "phone": string,              // best guess or "" if not present in resume
  "education": [{ "degree": string, "school": string, "year": string }],
  "certifications": [string],
  "skillsMatched": [string],    // required/preferred skills clearly demonstrated in the resume
  "skillsPartial": [string],    // skills that are somewhat but not strongly demonstrated
  "skillsMissing": [string],    // required skills from the job that are absent from the resume
  "breakdown": {
    "skill": number,            // 0-100, match on required skills
    "experience": number,       // 0-100, years & relevance of experience
    "responsibility": number,   // 0-100, overlap with job responsibilities
    "education": number,        // 0-100, education fit
    "preferred": number,        // 0-100, preferred/nice-to-have skills coverage
    "seniority": number         // 0-100, seniority level fit
  },
  "score": number,               // 0-100 overall weighted match score
  "recommendation": "Strongly Recommend" | "Recommend" | "Review" | "Not a Fit",
  "aiVerdict": "Strong Hire" | "Hire" | "Consider" | "Reject",
  "strengths": [string],         // 2-4 concise bullets, specific to this resume
  "gaps": [string],              // 1-3 concise bullets, specific to this resume
  "timeline": [{ "title": string, "company": string, "dates": string, "desc": string }],
  "summary": string,             // 2-3 sentence overview referencing specifics from the resume
  "interviewQuestions": [string] // 2-4 tailored, specific interview questions
}`;

function buildScreeningSystemPrompt(job) {
  return `You are an expert, unbiased technical recruiter AI performing resume screening for TalentLens AI, an applicant tracking system.

You will be given a job's requirements and a single candidate's resume. Read the resume carefully and produce a structured evaluation of how well this candidate matches the role.

Job title: ${job.title}
Department: ${job.dept}
Location: ${job.location}
Seniority level: ${job.seniority}
Minimum experience: ${job.minExperience}+ years
Education preference: ${job.education}
Required skills: ${job.requiredSkills.join(", ")}
Preferred skills: ${job.preferredSkills.join(", ")}
Key responsibilities: ${job.responsibilities.join("; ")}
Relevant keywords: ${job.keywords.join(", ")}

Scoring rules:
- Base every judgment strictly on job-relevant qualifications found in the resume text.
- NEVER use or infer race, ethnicity, national origin, religion, gender, sexual orientation, age, disability, marital/family status, or any other protected characteristic when scoring, and do not mention them.
- Weight roughly: required skills 35%, experience 25%, responsibilities/domain overlap 15%, education/certifications 10%, preferred skills 10%, seniority fit 5% — but use judgment for the overall "score".
- Be specific and cite concrete details from the resume in strengths, gaps, summary, and interview questions. Do not invent facts not supported by the resume.
- If a field (like email or phone) is not present in the resume, return an empty string for it.

Respond with ONLY a single valid JSON object matching exactly this schema — no markdown code fences, no preamble, no trailing commentary:
${CANDIDATE_JSON_SCHEMA}`;
}

async function screenResumeWithAI(job, fileContent, fileName) {
  const system = buildScreeningSystemPrompt(job);
  let userContent;
  if (fileContent.kind === "pdf") {
    userContent = [
      { type: "document", source: { type: "base64", media_type: "application/pdf", data: fileContent.base64 } },
      { type: "text", text: `The attached PDF is the candidate's resume (filename: ${fileName}). Evaluate it against the job above and respond with the JSON object only.` },
    ];
  } else {
    const trimmed = fileContent.text.slice(0, 20000);
    userContent = [
      { type: "text", text: `Candidate resume (filename: ${fileName}), extracted text:\n\n"""\n${trimmed}\n"""\n\nEvaluate it against the job above and respond with the JSON object only.` },
    ];
  }
  const raw = await callClaude({
    system,
    messages: [{ role: "user", content: userContent }],
    max_tokens: 2200,
  });
  const parsed = extractJson(raw);
  return parsed;
}

async function askAssistantAI(question, candidates, job) {
  const compact = candidates.map((c) => ({
    name: c.name, role: c.role, company: c.company, score: c.score,
    recommendation: c.recommendation, aiVerdict: c.aiVerdict, experience: c.experience,
    status: c.status, skillsMatched: c.skillsMatched, skillsPartial: c.skillsPartial,
    skillsMissing: c.skillsMissing, strengths: c.strengths, gaps: c.gaps,
    certifications: c.certifications, summary: c.summary,
  }));
  const system = `You are the AI screening assistant inside TalentLens AI, an applicant tracking system. You answer a recruiter's questions about the candidate pool for the role below, using ONLY the candidate data provided as JSON. Be concise, specific, and reference candidate names and scores where relevant. Use plain text with short paragraphs and, when listing multiple candidates, simple "- Name — detail" lines. Never use or reference protected characteristics. If the data doesn't answer the question, say so plainly.

Job: ${job.title} (${job.dept}, ${job.location})
Required skills: ${job.requiredSkills.join(", ")}
Preferred skills: ${job.preferredSkills.join(", ")}

Candidate pool JSON:
${JSON.stringify(compact)}`;

  const text = await callClaude({
    system,
    messages: [{ role: "user", content: question }],
    max_tokens: 900,
  });
  return text.trim();
}

/* ============================== PRIMITIVES ============================== */

function ScoreRing({ score, size = 56, stroke = 5, label = true }) {
  const r = (size - stroke) / 2;
  const circ = 2 * Math.PI * r;
  const color = score >= 85 ? C.emerald : score >= 70 ? C.blue : score >= 55 ? C.amber : C.rose;
  const [dash, setDash] = useState(circ);
  useEffect(() => {
    const t = setTimeout(() => setDash(circ - (score / 100) * circ), 60);
    return () => clearTimeout(t);
  }, [score, circ]);
  return (
    <div style={{ width: size, height: size, position: "relative" }} className="shrink-0">
      <svg width={size} height={size} style={{ transform: "rotate(-90deg)" }}>
        <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke={C.borderSoft} strokeWidth={stroke} />
        <circle
          cx={size / 2} cy={size / 2} r={r} fill="none" stroke={color} strokeWidth={stroke}
          strokeLinecap="round" strokeDasharray={circ} strokeDashoffset={dash}
          style={{ transition: "stroke-dashoffset 1s cubic-bezier(.4,0,.2,1)" }}
        />
      </svg>
      {label && (
        <div style={{ position: "absolute", inset: 0 }} className="flex items-center justify-center">
          <span className="tl-mono" style={{ fontSize: size * 0.28, fontWeight: 600, color: C.text }}>{score}</span>
        </div>
      )}
    </div>
  );
}

function Badge({ children, bg, fg, style }) {
  return (
    <span
      className="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium"
      style={{ background: bg, color: fg, ...style }}
    >
      {children}
    </span>
  );
}

function StatusBadge({ status }) {
  const s = STATUS_STYLE[status] || STATUS_STYLE.New;
  return <Badge bg={s.bg} fg={s.fg}>{status}</Badge>;
}

function RecBadge({ rec }) {
  const color = REC_STYLE[rec] || C.muted;
  return (
    <span className="inline-flex items-center gap-1.5 text-xs font-medium" style={{ color }}>
      <span style={{ width: 6, height: 6, borderRadius: 999, background: color, display: "inline-block" }} />
      {rec}
    </span>
  );
}

function Card({ children, className = "", style, onClick }) {
  return (
    <div
      onClick={onClick}
      className={`rounded-2xl ${className}`}
      style={{ background: C.surface, border: `1px solid ${C.border}`, ...style }}
    >
      {children}
    </div>
  );
}

function Button({ children, variant = "primary", size = "md", icon: Icon, className = "", ...props }) {
  const base = "tl-focus inline-flex items-center justify-center gap-2 rounded-lg font-medium transition-colors whitespace-nowrap";
  const sizes = { sm: "text-xs px-3 py-1.5", md: "text-sm px-4 py-2.5", lg: "text-sm px-5 py-3" };
  const variants = {
    primary: { background: C.violet, color: "#fff" },
    secondary: { background: C.raised2, color: C.text, border: `1px solid ${C.border}` },
    ghost: { background: "transparent", color: C.muted },
    danger: { background: "rgba(240,103,138,0.12)", color: C.rose },
  };
  return (
    <button
      className={`${base} ${sizes[size]} ${className}`}
      style={{ ...variants[variant], opacity: props.disabled ? 0.55 : 1, cursor: props.disabled ? "not-allowed" : "pointer" }}
      {...props}
    >
      {Icon && <Icon size={15} />}
      {children}
    </button>
  );
}

function BarMeter({ pct, color = C.violet, height = 6 }) {
  return (
    <div style={{ height, background: C.borderSoft, borderRadius: 999, overflow: "hidden" }}>
      <div style={{ width: `${pct}%`, height: "100%", background: color, borderRadius: 999, transition: "width .6s ease" }} />
    </div>
  );
}

function Progress({ label, pct, color }) {
  return (
    <div>
      <div className="flex items-center justify-between mb-1.5">
        <span className="text-xs" style={{ color: C.muted }}>{label}</span>
        <span className="tl-mono text-xs" style={{ color: C.text }}>{pct}%</span>
      </div>
      <BarMeter pct={pct} color={color} />
    </div>
  );
}

